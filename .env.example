# Admin panel login (/admin)
ADMIN_PASSWORD=change-me
# Random string used to sign the admin login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Supabase → Project Settings → API (server-side only, never expose in the browser)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
